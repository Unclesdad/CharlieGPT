<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: deploy/launchd/install.sh fills in __UV__ and __REPO__. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.charliegpt.imessage</string>
    <key>ProgramArguments</key>
    <array>
        <string>__UV__</string>
        <string>run</string>
        <string>--project</string>
        <string>__REPO__</string>
        <string>charliegpt</string>
        <string>bot</string>
        <string>imessage</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/charliegpt-imessage.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/charliegpt-imessage.log</string>
</dict>
</plist>
